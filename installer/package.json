{
  "name": "crm-agent-installer",
  "version": "0.2.2",
  "description": "Resumable customer installer for the CRM export lead generation Agent",
  "author": "CRM Agent",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "brand:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1",
    "prepare:payload": "node scripts/prepare-payload.mjs",
    "pack:x64": "electron-builder --win nsis portable --x64",
    "pack:arm64": "electron-builder --win nsis portable --arm64",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "dist:x64": "npm run brand:assets && npm run prepare:payload && npm run build && npm run pack:x64",
    "dist:arm64": "npm run brand:assets && npm run prepare:payload && npm run build && npm run pack:arm64",
    "dist:all": "npm run brand:assets && npm run prepare:payload && npm run build && npm run pack:x64 && npm run pack:arm64 && npm run release:manifest"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "adm-zip": "0.5.16",
    "imapflow": "1.4.7",
    "lucide-react": "1.24.0",
    "nodemailer": "9.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ssh2": "1.17.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/adm-zip": "0.5.7",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.example.exportagent.installer",
    "productName": "CRM Agent Installer",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    }
  }
}
