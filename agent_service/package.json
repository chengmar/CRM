    "fastify": "5.10.0",
    "fastify-raw-body": "5.0.0",
    "imapflow": "1.4.7",
    "mailparser": "3.9.14",
    "nodemailer": "9.0.3",
    "p-limit": "7.3.0",
    "pino": "10.3.1",
    "robots-parser": "3.0.1",
    "tldts": "7.0.22",
    "undici": "7.28.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
