[Unit]
Description=Chaoxing SeatBot one-shot reservation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seatbot
Group=seatbot
WorkingDirectory=/opt/chaoxing-seatbot
EnvironmentFile=/etc/chaoxing-seatbot/seatbot.env
ExecStart=/opt/chaoxing-seatbot/.venv/bin/python -m seatbot.main --config /etc/chaoxing-seatbot/config.yaml reserve
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/chaoxing-seatbot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
