# Copy this file to .env on the Hermes/OpenClaw host and fill real values there.
# Never commit or share the filled .env.

# Runtime
DEPLOYMENT_MODE=vps
AGENT_MODE=dry_run
AGENT_DB_PATH=
AGENT_HTTP_HOST=127.0.0.1
AGENT_HTTP_PORT=18790
AGENT_LOG_LEVEL=info
OUTBOUND_ENABLED=false
OUTBOUND_SENDING_STALE_SECONDS=300
HERMES_HOME=
HERMES_RESEARCH_ENABLED=true
HERMES_COMMAND=hermes
HERMES_RESEARCH_TIMEOUT_SECONDS=300
AUTO_LEADS_TEAM_DIR=
AUTO_LEADS_LOG_DIR=shared-data/metrics
AUTO_LEADS_TIMEZONE=Asia/Shanghai

# Model provider. Fill one provider path first, then verify `hermes model`.
# Example OpenAI-compatible provider settings are collected by the installer.
# Put the real key only in your private .env or user-level runtime config.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENROUTER_API_KEY=
NOUS_API_KEY=

# Feishu / Lark bot
FEISHU_BOT_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
FEISHU_REQUIRE_MENTION=true
FEISHU_GROUP_POLICY=allowlist
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=
# Server-side role bindings. Pairing or FEISHU_ALLOWED_USERS grants bot access only.
# Example: {"ou_sales_manager":["SALES_MANAGER"],"ou_budget":["BUDGET_APPROVER"]}
FEISHU_TRUSTED_USER_ROLES=
# Separate, default-deny allowlists for grounded message content review.
FEISHU_MESSAGE_REVIEWER_USERS=
FEISHU_MESSAGE_REVIEW_DESTINATIONS=
FEISHU_PAIRING_CODE=
FEISHU_HOME_CHANNEL=
FEISHU_ALERT_OPEN_IDS=
FEISHU_ALERT_CHAT_ID=
# A successfully paired user and group are also registered as inquiry alert destinations.

# Feishu Sheets / CRM
FEISHU_SHEETS_APP_ID=
FEISHU_SHEETS_APP_SECRET=
CRM_WIKI_URL=
CRM_SPREADSHEET_TOKEN=
CRM_SHEET_ID=
CRM_TABLE_COLUMNS=created_at,market,product,company,website,country,buyer_type,contact_name,title,email,whatsapp,linkedin,source_url,score,grade,match_reason,recommended_channel,email_draft,whatsapp_opener,status,next_follow_up_at,owner
FEISHU_CRM_SYNC_ENABLED=false
FEISHU_CRM_SYNC_MODE=OverwriteAll
FEISHU_CRM_WRITE_TEST_PASSED=false
FEISHU_CRM_WRITE_TEST_PASSED_AT=

# Feishu Bitable control plane. Recommended for the production CRM/dashboard.
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_LEADS_TABLE_ID=
FEISHU_BITABLE_EVENTS_TABLE_ID=
# Control-table export is separately opt-in. Leave disabled for legacy Leads/Events-only bases.
# Enable only after explicit bootstrap has written local ownership markers, or provide all four IDs.
FEISHU_BITABLE_CONTROL_SYNC_ENABLED=false
FEISHU_BITABLE_CAMPAIGN_BRIEFS_TABLE_ID=
FEISHU_BITABLE_MARKET_ALLOCATIONS_TABLE_ID=
FEISHU_BITABLE_SALES_TASKS_TABLE_ID=
FEISHU_BITABLE_COMMERCIAL_REPORT_TABLE_ID=

# Email outreach, optional. Keep disabled until domain, unsubscribe, and rate limits are ready.
EMAIL_OUTREACH_ENABLED=false
EMAIL_INBOUND_ENABLED=false
# Explicit exception for an early Gmail pilot. This never makes Gmail production-ready.
CONSUMER_EMAIL_PILOT_ENABLED=false
EMAIL_POLL_SECONDS=60
IMAP_HEALTH_STALE_SECONDS=300
IMAP_FAILURE_PAUSE_THRESHOLD=3
IMAP_MESSAGE_MAX_ATTEMPTS=3
EMAIL_SEND_REQUIRES_CONFIRMATION=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
COMPANY_POSTAL_ADDRESS=
EMAIL_DOMAIN_AUTH_VERIFIED=false
EMAIL_WARMUP_COMPLETE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
EMAIL_DAILY_LIMIT=50
EMAIL_HOURLY_LIMIT=20
# Gmail pilot uses adaptive pacing within these operator targets.
EMAIL_MIN_INTERVAL_SECONDS=120
EMAIL_MAX_HARD_BOUNCE_RATE=0.03
EMAIL_UNSUBSCRIBE_TEXT=
OUTBOUND_DISPATCH_MAX_BATCH=10
FOLLOWUP_DAYS=3,7,14
AUTO_FOLLOWUP_ENABLED=false

# WhatsApp outreach, optional. Prefer WhatsApp Business API or another explicitly approved compliant channel.
WHATSAPP_OUTREACH_ENABLED=false
WHATSAPP_BUSINESS_API_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_BODY_PARAM_FIELDS=company
WHATSAPP_DAILY_LIMIT=20
WHATSAPP_SEND_REQUIRES_CONFIRMATION=true
PUBLIC_BASE_URL=

# VPS deployment target, optional. Fill only on the operator machine, never in shared docs.
VPS_IP=
VPS_SSH_USER=
VPS_SSH_KEY_PATH=
VPS_SSH_PASSWORD=
VPS_SSH_HOSTKEY=
VPS_UBUNTU_VERSION=
VPS_REGION=

# Search / proxy / anti-blocking. Configure only on the host that runs search tasks.
SEARCH_PROXY_URL=
SEARCH_PROVIDER=none
SERPER_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
SEARXNG_BASE_URL=
# Enables only the strict, campaign-budget-bound read-only adapter.
ACQ_SEARXNG_V2_ENABLED=false
# Allows only http://127.0.0.1:<port> or http://[::1]:<port>; RFC1918 hosts stay blocked.
SEARXNG_LOCAL_ENDPOINT_ALLOWED=false
SEARXNG_REQUEST_TIMEOUT_MS=20000
SEARXNG_CACHE_TTL_SECONDS=3600
ACQ_LOCAL_PUBLIC_WEB_ENABLED=false
LOCAL_PUBLIC_WEB_TIMEOUT_MS=20000
LOCAL_PUBLIC_WEB_CACHE_TTL_SECONDS=3600
REACHER_BASE_URL=
HUNTER_API_KEY=
HUNTER_BASE_URL=https://api.hunter.io/v2
HUNTER_MIN_CONFIDENCE=80
# Enables only campaign-bound verification of work emails already found on public webpages.
# Hunter Finder remains disabled in the production discovery bridge.
ACQ_HUNTER_V2_ENABLED=false
HUNTER_REQUEST_TIMEOUT_MS=20000
HUNTER_CACHE_TTL_SECONDS=86400
# One configured Hunter verification credit per call. Set the USD allocation when known.
HUNTER_EMAIL_VERIFICATION_COST_UNITS=1
HUNTER_EMAIL_VERIFICATION_COST_MICROS=0
# Strict Bouncer verification adapter. The credential is sent only in the x-api-key header.
BOUNCER_API_KEY=
ACQ_BOUNCER_V2_ENABLED=false
BOUNCER_REQUEST_TIMEOUT_MS=20000
BOUNCER_CACHE_TTL_SECONDS=86400
BOUNCER_EMAIL_VERIFICATION_COST_UNITS=1
BOUNCER_EMAIL_VERIFICATION_COST_MICROS=0
MAX_SEARCH_RESULTS_PER_CAMPAIGN=500
MAX_PAGES_PER_CAMPAIGN=1600
MAX_LLM_CALLS_PER_JOB=300
MAX_DISCOVERY_CONCURRENCY=6
MAX_SEARCH_CONCURRENCY=4
# Independent worker limits per durable job lane. Research defaults to two concurrent long-running jobs.
JOB_WORKER_REALTIME_CONCURRENCY=2
JOB_WORKER_OPERATIONS_CONCURRENCY=1
JOB_WORKER_RESEARCH_CONCURRENCY=2
SEARCH_RETRY_ATTEMPTS=3
SEARCH_RETRY_BASE_DELAY_MS=1000
MAX_DISCOVERY_ROUNDS=3
MAX_COMPANY_PAGES=8
MAX_CONTACTS_PER_COMPANY=4
DISCOVERY_PROGRESS_INTERVAL=10
DAILY_RESEARCH_ENABLED=false
DAILY_RESEARCH_HOUR=9
DAILY_RESEARCH_TIMEZONE=Asia/Shanghai
DAILY_RESEARCH_MARKETS=Malaysia,Vietnam,Philippines,Indonesia,Mexico
DAILY_RESEARCH_TARGET=15
DAILY_OPERATIONS_REPORT_ENABLED=true
DAILY_OPERATIONS_REPORT_HOUR=20
DAILY_OPERATIONS_REPORT_TIMEZONE=Asia/Shanghai
MAX_LLM_RESPONSE_TOKENS=2400
MODEL_DAILY_TOKEN_BUDGET=10000000
OPENAI_CLASSIFIER_MODEL=
OPENAI_RESEARCH_MODEL=

# Lead quality gate
LEAD_SEND_SCORE_MIN=90
COMPANY_ACTIVITY_MAX_AGE_DAYS=548

# Customs/trade data, optional
CUSTOMS_API_KEY=
CUSTOMS_API_BASE_URL=

# Safety defaults
SPREADSHEET_WRITE_REQUIRES_CONFIRMATION=true
EXTERNAL_SEND_REQUIRES_CONFIRMATION=true
USE_PUBLIC_DATA_ONLY=true
REQUIRE_SOURCE_URL_FOR_COMPANY_FACTS=true
REQUIRE_HUMAN_APPROVAL_BEFORE_SEND=true
OUTREACH_APPROVAL_REQUIRED=true
