WORDPRESS_PORT=8088
WORDPRESS_DB_NAME=demo_manufacturer_wp
WORDPRESS_DB_USER=demo_manufacturer_wp
WORDPRESS_DB_PASSWORD=replace-with-a-local-only-password
WORDPRESS_DB_ROOT_PASSWORD=replace-with-a-different-local-only-password
WORDPRESS_DEBUG=1

# Used only when provision-local.ps1 installs a new WordPress database.
WORDPRESS_URL=http://127.0.0.1:8088
WORDPRESS_TITLE=Demo Manufacturer Local
WORDPRESS_ADMIN_USER=demo_manufacturer_local_admin
WORDPRESS_ADMIN_PASSWORD=replace-with-a-third-local-only-password
WORDPRESS_ADMIN_EMAIL=sales@example.com
